# Public Supabase values (safe for the browser). Never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Email logos use the public Storage object at
# ${NEXT_PUBLIC_SUPABASE_URL}/storage/v1/object/public/brand/logo.png
# not the Vercel site origin.

# Sign-in codes are sent by Supabase Auth, not the Gmail API.
# Reservation mail (new request, approved, declined) uses the Gmail API as the school mailbox.
# Create an OAuth client, add redirect http://127.0.0.1:42813/oauth2callback, then:
#   node scripts/gmail-oauth.mjs
# Sign in as the school mailbox when Google asks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Signed Approve/Decline links in the request-notice email.
# Falls back to GOOGLE_CLIENT_SECRET when unset.
EMAIL_DECISION_SECRET=

# Optional. Set to .setonschool.net in production so Spaces and Help share the auth session.
NEXT_PUBLIC_COOKIE_DOMAIN=
